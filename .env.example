# Public browser settings for F2. Keep service credentials on the backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional F3 cloud transcription. Use this project's /functions/v1/transcribe-recipe endpoint.
VITE_CLOUD_TRANSCRIPTION_URL=
VITE_CLOUD_TRANSCRIPTION_PROVIDER=Groq
VITE_CLOUD_TRANSCRIPTION_MAX_MB=8
# Set the Spanish consent note after enabling Zero Data Retention for this provider.
VITE_CLOUD_TRANSCRIPTION_RETENTION=

# Optional F4 local OCR. Folder with the engine files, relative to the page or on this origin. Defaults to ./ocr/.
VITE_OCR_ASSET_BASE=
