{
  "name": "recetario-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "ocr:assets": "node src/capture/media/copy-assets.mjs",
    "predev": "npm run ocr:assets",
    "dev": "vite",
    "prebuild": "npm run ocr:assets",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prebuild:e2e": "npm run ocr:assets",
    "build:e2e": "vite build --outDir node_modules/.cache/e2e-dist --emptyOutDir",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@solidjs/web": "2.0.3",
    "@supabase/supabase-js": "2.119.2",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@solidjs/vite-plugin": "3.0.1",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "tesseract.js": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
